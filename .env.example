# Copy to .env and adjust. Never commit .env.

# Postgres connection used by the API (keys + usage metering) and the db:* scripts.
DATABASE_URL=postgres://panchang:panchang@localhost:5432/panchang

# Separate database used only by `npm run test:db` (integration tests against real Postgres).
DATABASE_URL_TEST=postgres://panchang:panchang@localhost:5432/panchang_test

# Development only: `npm run db:seed` creates an API key with exactly this plaintext.
# Leave empty in production.
SEED_API_KEY=pk_live_dev_local_only_change_me
